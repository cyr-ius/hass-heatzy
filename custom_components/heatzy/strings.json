{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Register your heatzy account",
        "data": {
          "username": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]"
        },
        "data_description": {
          "username": "The email address of your Heatzy account (the one used in the Heatzy app).",
          "password": "The password of your Heatzy account."
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate your Heatzy account",
        "description": "The password of {username} was refused. Enter the new password of the account.",
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        },
        "data_description": {
          "password": "The password of your Heatzy account."
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_service%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    }
  },
  "services": {
    "boost": {
      "name": "Set Boost",
      "description": "Setting boost mode",
      "fields": {
        "delay": {
          "name": "Delay",
          "description": "Boost delay (minutes)"
        }
      }
    },
    "vacation": {
      "name": "Set Vacation",
      "description": "Setting vacation mode",
      "fields": {
        "delay": {
          "name": "Delay",
          "description": "Vacation delay (days)"
        }
      }
    },
    "presence": {
      "name": "Set Presence",
      "description": "Enable or disable presence detection mode"
    },
    "window_switch": {
      "name": "Set Window Switch",
      "description": "Setting window switch mode"
    }
  },
  "entity": {
    "number": {
      "calibration": {
        "name": "Temperature calibration"
      },
      "vacation": {
        "name": "Vacation"
      },
      "boost": {
        "name": "Boost"
      }
    },
    "binary_sensor": {
      "connectivity": {
        "name": "Connectivity"
      },
      "presence_detected": {
        "name": "Presence detection"
      }
    },
    "switch": {
      "lock": {
        "name": "Lock"
      },
      "window": {
        "name": "Window"
      },
      "presence_enabled": {
        "name": "Presence mode"
      }
    }
  },
  "exceptions": {
    "command_failed": {
      "message": "Command to {device} failed: {error}"
    },
    "invalid_auth": {
      "message": "The Heatzy account password was refused."
    }
  }
}
